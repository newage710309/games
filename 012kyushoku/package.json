{
  "name": "sakura-kyushoku",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "さくらちゃんの給食当番 - 森の学校の給食室で、並んだ森の子たちにちょうどいい種類と量の給食をよそう全 3 面のゲーム (TypeScript + Vite + Canvas2D)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "bot": "esbuild tools/bot.ts --bundle --platform=node --log-level=warning --outfile=dist-tools/bot.cjs && node dist-tools/bot.cjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
