{
  "name": "sakura-enagadango",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "さくらちゃんのエナガだんご - シーソーの枝に鳥をならべてつり合わせる全 3 面・14 問のパズル (TypeScript + Vite + Canvas2D)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "solve": "esbuild tools/solve.ts --bundle --platform=node --log-level=warning --outfile=dist-tools/solve.cjs && node dist-tools/solve.cjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
